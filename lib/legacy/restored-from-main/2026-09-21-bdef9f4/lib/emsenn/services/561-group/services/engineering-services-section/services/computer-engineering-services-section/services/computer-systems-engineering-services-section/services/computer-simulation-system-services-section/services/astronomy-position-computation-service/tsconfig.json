{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "declaration": true, "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, "rewriteRelativeImportExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.mts"]
}
