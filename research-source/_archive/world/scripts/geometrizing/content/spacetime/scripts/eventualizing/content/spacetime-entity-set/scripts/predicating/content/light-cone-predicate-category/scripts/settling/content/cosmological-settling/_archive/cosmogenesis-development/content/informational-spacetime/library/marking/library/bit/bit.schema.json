{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacetime.lab.development.561.group/library/informational-spacetime/library/marking/library/bit/bit.schema.json",
  "title": "bit",
  "description": "The elementary two-fold (presence/absence) marking produces. Is the kernel's aperiodic cell: Shannon's bit = the voidmath cell. Its value is typed by the kernel cell schema via the promoted voidmath-kernel-schema package.",
  "type": "object",
  "properties": {
    "name": { "type": "string", "const": "bit" },
    "kind": { "type": "string", "const": "object" },
    "is": { "type": "string", "const": "cell" },
    "generated-by": { "type": "string", "const": "marking" },
    "value": { "$ref": "https://voidmath.active.development.561.group/articulating/library/category/library/cell/cell.schema.json" }
  },
  "required": ["name", "is"]
}
