{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://active.development.561.group/articulating/library/aperiodic-articulation-category/cosmogenerating/library/cosmos/cosmic-predicating/library/cosmic-transfinite-predication/cosmic-positing/library/cosmic-scott-posit/thermalizing/library/cosmic-finite-thermalization-algebra/hacking/library/cosmic-increment-sequence/cosmic-increment-sequence.schema.json",
  "title": "cosmic-increment-sequence",
  "description": "An instance of increment-sequence (cross-tower analog of collatz-increment-sequence) whose per-step evidence injects the next epoch's scale factor a(τ) as positive evidence on the redshift-indexed base. Drives cosmic-thermalization. Discretization of continuous cosmic time into thermalizing stages is asserted (hacking).",
  "type": "object",
  "properties": {
    "name": { "type": "string", "const": "cosmic-increment-sequence" },
    "derives-from": { "type": "string", "const": "increment-sequence" },
    "depends-on": {
      "type": "array",
      "items": { "type": "string" },
      "description": "[increment-sequence, redshift-reindexing]"
    },
    "base": {
      "type": "object",
      "description": "The fixed increment-sequence base (redshift-indexed observables).",
      "properties": {
        "predicate": { "type": "string", "const": "reached-scale" },
        "entities": { "type": "string", "const": "scale-factor-values", "description": "a(τ), the scale factor reached at stage τ." },
        "reindexing": { "type": "string", "const": "redshift-reindexing" }
      },
      "required": ["predicate", "entities"]
    },
    "increments": {
      "type": "array",
      "description": "The increment u_τ at each thermalizing step: the next epoch's scale factor as positive evidence.",
      "items": {
        "type": "object",
        "properties": {
          "stage": { "type": "integer", "minimum": 0 },
          "scale-factor": { "type": "number", "exclusiveMinimum": 0, "description": "a(τ), monotone in τ." },
          "posits-cell": { "type": "string", "description": "reached-scale(a_τ) := t" }
        },
        "required": ["stage", "scale-factor"]
      }
    },
    "status": { "type": "string", "const": "hacking" }
  },
  "required": ["name", "derives-from", "base"]
}
